# ---------------------------------------------------------------------------
# Пример переменных окружения. Скопируйте этот файл в `.env.local` и подставьте
# реальные значения. НИКОГДА не коммитьте реальные секреты — `.env*` (кроме
# `.env.example`) игнорируется git.
# ---------------------------------------------------------------------------

# Строка подключения к основной базе данных PostgreSQL (Better Auth сессии,
# пользователи, а также будущая изоляция данных по userId).
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/shopping_list

# Отдельная одноразовая тестовая база данных (используется интеграционными
# тестами изоляции). Должна быть НЕ той же, что prod/dev — данные затираются.
DATABASE_URL_TEST=postgresql://user:password@localhost:5432/shopping_list_test

# Секрет Better Auth для подписи сессий/куки. Минимум 32 символа.
# Сгенерировать: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
