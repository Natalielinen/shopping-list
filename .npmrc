; @hookform/resolvers@5.x объявляет optional peer valibot ^1.0.0, но его
; транзитивная зависимость @typeschema/valibot тянет valibot 0.39 — конфликт
; только в необязательном peer, который проект не использует (валидация на Zod).
; legacy-peer-deps снимает эту ложную блокировку установки.
legacy-peer-deps=true
save-exact=true
